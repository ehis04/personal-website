{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ehisoghina",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ehisoghina" }],
  "observability": { "enabled": true }
  // Custom domain: once ehisoghina.com is a zone on your Cloudflare account, add
  //   "routes": [{ "pattern": "ehisoghina.com", "custom_domain": true }]
  // Secrets are NOT set here. Use: npx wrangler secret put ANTHROPIC_API_KEY
}
