{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ehisoghina",
  // Only /api/* runs this code; every other request is a static file from the "out" folder,
  // served straight from Cloudflare's edge (no code, no CPU limit).
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Custom domains (the ehisoghina.com zone must be active on this Cloudflare account).
  // Cloudflare creates the DNS records for these automatically on deploy.
  "routes": [
    { "pattern": "ehisoghina.com", "custom_domain": true },
    { "pattern": "www.ehisoghina.com", "custom_domain": true }
  ]
  // Secrets are NOT set here. Use: npx wrangler secret put ANTHROPIC_API_KEY
}
