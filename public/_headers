# Applied by Cloudflare to every static file (this file is copied into the build output).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)

# Hashed build files never change, so they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and clips are replaced by new file names, so a day is safe and fast.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/cv/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon.png
  Cache-Control: public, max-age=86400
/apple-icon.png
  Cache-Control: public, max-age=86400
